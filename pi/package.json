{
  "name": "@sesori/pr-monitor-pi",
  "version": "0.5.0",
  "description": "Pi and OMP extension that watches GitHub PRs, manages readiness, and reports into the active session",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./omp": {
      "types": "./dist/omp.d.ts",
      "import": "./dist/omp.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sesori-ai/pr-monitor-plugin.git"
  },
  "homepage": "https://github.com/sesori-ai/pr-monitor-plugin#readme",
  "bugs": {
    "url": "https://github.com/sesori-ai/pr-monitor-plugin/issues"
  },
  "author": {
    "name": "Sesori",
    "url": "https://github.com/sesori-ai"
  },
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "oh-my-pi",
    "github",
    "pull-request",
    "monitor"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node ../scripts/build-pi.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm --prefix .. run release:check"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "omp": {
    "extensions": [
      "./dist/omp.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
