{
  "name": "@sesori/pr-monitor-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "deepseek",
    "opencode",
    "pi"
  ],
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:opencode && npm run build:pi && npm run build:deepseek && npm run build:claude && npm run build:hermes",
    "build:opencode": "node scripts/build-opencode.mjs",
    "build:pi": "node scripts/build-pi.mjs",
    "build:deepseek": "node scripts/build-deepseek.mjs",
    "build:claude": "node scripts/build-claude.mjs",
    "build:hermes": "node scripts/build-hermes.mjs",
    "clean": "node scripts/clean.mjs",
    "pack:check": "npm run build:opencode && npm run build:pi && npm run build:deepseek && node scripts/check-pack.mjs",
    "host:check": "npm run build:pi && npm run build:deepseek && node scripts/check-pi-loader.mjs && node scripts/check-pi-package.mjs && node scripts/run-omp-loader-check.mjs && node scripts/run-deepseek-loader-check.mjs",
    "host:check:opencode": "npm run build:opencode && node scripts/check-opencode-loader.mjs",
    "host:check:omp": "npm run build:pi && node scripts/run-omp-loader-check.mjs",
    "host:check:deepseek": "npm run build:deepseek && node scripts/run-deepseek-loader-check.mjs",
    "version:check": "node scripts/check-versions.mjs",
    "release:check": "npm test && npm run typecheck && npm run build && npm run version:check && npm run pack:check && npm run host:check"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-skill": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typebox": "1.3.7",
    "typescript": "^5.8.0",
    "zod": "^4.4.3"
  }
}
